    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst tz = 'America/New_York';\nconst events = items.map(i => i.json).filter(e => e && (e.summary || e.start));\n\nevents.sort((a, b) => {\n  const aStart = (a.start && (a.start.dateTime || a.start.date)) || '';\n  const bStart = (b.start && (b.start.dateTime || b.start.date)) || '';\n  return aStart.localeCompare(bStart);\n});\n\nconst lines = [];\nif (events.length === 0) {\n  lines.push('No events today. Enjoy the calm!');\n} else {\n  for (const e of events) {\n    let timeStr;\n    if (e.start && e.start.dateTime) {\n      const dt = new Date(e.start.dateTime);\n      timeStr = dt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: tz });\n    } else {\n      timeStr = 'All day';\n    }\n    lines.push(timeStr + ' - ' + (e.summary || '(no title)'));\n  }\n}\n\nconst dateLabel = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: tz });\nconst message = 'Good morning! Here is ' + dateLabel + ':\\n\\n' + lines.join('\\n') +\n  '\\n\\nReply \"tomorrow\" or \"week\" for more, or \"add: <event>\" to add something new.';\n\nreturn [{ json: { message } }];"
      },
