        848,
        304
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const notionTasks = $(\"Notion Tasks\").all().map(i => i.json);\nconst existingTasks = $input.all().map(i => i.json);\nconst results = [];\nfor (const t of notionTasks) {\n  const title = (t.name || t.title || \"\").toString().trim();\n  if (!title) continue;\n  const match = existingTasks.find(e => (e.name || \"\").trim().toLowerCase() === title.toLowerCase());\n  if (match) {\n    results.push({ json: { action: \"update\", clickupId: match.id, name: title } });\n  } else {\n    results.push({ json: { action: \"create\", name: title } });\n  }\n}\nreturn results;"
      },
