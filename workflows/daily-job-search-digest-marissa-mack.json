    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of items) {\n  const score = item.json.choices?.[0]?.message?.content?.trim() || '0';\n  const jobData = $(\"Loop Over Items\").item.json;\n  \n  const parsedScore = parseInt(score) || 0;\n  \n  if (parsedScore < 2) continue;\n  \n  results.push({\n    json: {\n      date_found: new Date().toLocaleDateString('en-US'),\n      job_title: jobData.job_title || jobData.positionName || jobData.title || '',\n      company: jobData.company || jobData.company_name || jobData.companyName || '',\n      location: jobData.location || jobData.candidate_required_location || 'Remote',\n      salary: jobData.salary || '',\n      job_board: jobData.job_board || 'Indeed',\n      url: jobData.url || '',\n      ai_score: parsedScore,\n      applied: 'No'\n    }\n  });\n}\nreturn results;"
      },
