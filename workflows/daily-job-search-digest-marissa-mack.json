        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a job fit evaluator. Score jobs 1-10 for this candidate: Marissa is an entry-level administrative professional in Valrico FL looking for part-time work. Skills: Microsoft Office, data entry, records management, scheduling, customer service. Target roles: receptionist, front desk, administrative assistant, data entry clerk, office assistant, school admin. Open to in-person. Retail, warehouse, stocking, grocery, and food service roles score 1. Respond with ONLY a number 1-10.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ 'Job Title: ' + $json.job_title + ' Company: ' + $json.company + ' Location: ' + $json.location }}\"\n    }\n  ],\n  \"max_tokens\": 5,\n  \"temperature\": 0\n}",
