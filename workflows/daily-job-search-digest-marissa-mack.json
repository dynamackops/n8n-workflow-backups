    {
      "parameters": {
        "jsCode": "const jobs = [];\nfor (const item of items) {\n  const jobList = item.json.jobs || [];\n  \n  for (const job of jobList) {\n    const title = (job.title || '').toLowerCase();\n    const relevant = [\n      'administrative', 'admin', 'virtual assistant',\n      'data entry', 'coordinator', 'executive assistant',\n      'receptionist', 'office', 'clerical', 'records'\n    ];\n    \n    const isRelevant = relevant.some(keyword => title.includes(keyword));\n    if (!isRelevant) continue;\n    \n    jobs.push({\n      json: {\n        date_found: new Date().toLocaleDateString('en-US'),\n        job_title: job.title || '',\n        company: job.company_name || '',\n        location: job.candidate_required_location || 'Remote',\n        salary: job.salary || 'Not listed',\n        job_board: 'Remotive',\n        url: job.url || '',\n        ai_score: '',\n        applied: 'No'\n      }\n    });\n  }\n}\nreturn jobs;"
      },
