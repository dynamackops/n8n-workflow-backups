    {
      "id": "f103ae57-8766-4e38-bae1-dda76ba548a1",
      "name": "Prepare Event For Calendar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const extracted = $input.first().json.output || $input.first().json;\nconst allDay = !!extracted.allDay;\nconst summary = extracted.summary || 'New event';\nlet start = extracted.start;\nlet end;\n\nif (allDay) {\n  // Google Calendar all-day events: end date is exclusive, so add 1 day\n  const startDate = new Date(start + 'T00:00:00');\n  const endDate = new Date(startDate.getTime() + 24 * 60 * 60 * 1000);\n  end = endDate.toISOString().slice(0, 10);\n} else {\n  const startDate = new Date(start);\n  const endDate = new Date(startDate.getTime() + 60 * 60 * 1000);\n  start = startDate.toISOString();\n  end = endDate.toISOString();\n}\n\nconst to = $('SMS Received').first().json.From;\nreturn [{ json: { summary, start, end, allDay, to } }];"
      }
    },
