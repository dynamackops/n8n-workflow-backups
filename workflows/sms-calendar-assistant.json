      "id": "fbcb031b-b1f8-49cc-9fbd-efc0d650ed46",
      "name": "Anthropic Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.5,
      "position": [
        528,
        224
