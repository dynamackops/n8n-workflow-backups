    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst tz = 'America/New_York';\nconst events = items.map(i => i.json).filter(e => e && (e.summary || e.start));\n\nevents.sort((a, b) => {\n  const aStart = (a.start && (a.start.dateTime || a.start.date)) || '';\n  const bStart = (b.start && (b.start.dateTime || b.start.date)) || '';\n  return aStart.localeCompare(bStart);\n});\n\nconst lines = [];\nif (events.length === 0) {\n  lines.push('Nothing on the calendar this week.');\n} else {\n  for (const e of events) {\n    const start = e.start && (e.start.dateTime || e.start.date);\n    const dt = new Date(start);\n    let label;\n    if (e.start && e.start.dateTime) {\n      label = dt.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: tz }) +\n        ' ' + dt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: tz });\n    } else {\n      label = dt.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: tz }) + ' (all day)';\n    }\n    lines.push(label + ' - ' + (e.summary || '(no title)'));\n  }\n}\n\nconst message = 'This week:\\n\\n' + lines.join('\\n');\nconst to = $('SMS Received').first().json.From;\nreturn [{ json: { message, to } }];"
      },
