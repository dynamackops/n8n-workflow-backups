    {
      "parameters": {
        "jsCode": "const dedupRows = $('Sheets — Read Dedup Log').all().map(i => `${i.json['Platform']}:${(i.json['Username']||'').toLowerCase()}`);\nconst incoming = $('Extract + Normalize Profiles').all();\n\nconst newLeads = incoming.filter(item => {\n  const key = `${item.json.platform}:${item.json.username.toLowerCase()}`;\n  return !dedupRows.includes(key);\n});\n\nif (newLeads.length === 0) return [{ json: { skip: true, count: 0 } }];\nreturn newLeads;"
      },
