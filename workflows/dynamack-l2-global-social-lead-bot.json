    {
      "parameters": {},
      "id": "71b9bd4b-80a1-4f0e-ab04-5474364b5fd9",
      "name": "Merge — IG + TikTok",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        688,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize and deduplicate profiles from posts\nconst items = $input.all();\nconst seen = new Set();\nconst profiles = [];\n\nfor (const item of items) {\n  const d = item.json;\n\n  // Detect platform based on fields\n  const isIG = d.ownerUsername !== undefined;\n  const isTT = d.authorMeta !== undefined;\n\n  let username, fullName, bio, followers, profileUrl, caption, sourceHashtag, platform;\n\n  if (isIG) {\n    username = d.ownerUsername || '';\n    fullName = d.ownerFullName || '';\n    bio = d.ownerBiography || '';\n    followers = d.ownerFollowersCount || 0;\n    profileUrl = `https://instagram.com/${username}`;\n    caption = (d.caption || '').slice(0, 200);\n    sourceHashtag = (d.hashtags || [])[0] || 'sportsmemorabilia';\n    platform = 'Instagram';\n  } else if (isTT) {\n    username = d.authorMeta?.name || '';\n    fullName = d.authorMeta?.nickName || '';\n    bio = d.authorMeta?.signature || '';\n    followers = d.authorMeta?.fans || 0;\n    profileUrl = `https://tiktok.com/@${username}`;\n    caption = (d.text || '').slice(0, 200);\n    sourceHashtag = (d.challengeList || [{}])[0]?.title || 'sportsbreaker';\n    platform = 'TikTok';\n  } else {\n    continue;\n  }\n\n  if (!username) continue;\n\n  const key = `${platform}:${username.toLowerCase()}`;\n  if (seen.has(key)) continue;\n  seen.add(key);\n\n  profiles.push({\n    username: `@${username}`,\n    fullName,\n    bio,\n    followers,\n    profileUrl,\n    caption,\n    sourceHashtag,\n    platform,\n    business: 'L2 Global',\n    dateFound: new Date().toISOString().slice(0, 10)\n  });\n}\n\n// Cap at 15 per run to respect Groq rate limits\nreturn profiles.slice(0, 15).map(p => ({ json: p }));"
      },
