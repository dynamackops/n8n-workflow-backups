    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data;\n\n// Try standard JSON-LD first\nconst match = html.match(/<script type=\"application\\/ld\\+json\">([\\s\\S]*?)<\\/script>/);\n\nif (match) {\n  const job = JSON.parse(match[1]);\n  return [{ json: {\n    title: job.title,\n    company: job.hiringOrganization?.name,\n    location: job.jobLocation,\n    salary: job.baseSalary?.value ?? job.baseSalary?.minValue ?? null\n  }}];\n}\n\n// LinkedIn fallback\nconst rawTitle = html.match(/<title>(.*?)<\\/title>/)?.[1] ?? '';\n// LinkedIn title format: \"Company hiring Job Title in Location | LinkedIn\"\nconst titleMatch = rawTitle.match(/hiring (.+?) in (.+?)(?:\\s*\\||\\s*$)/);\n\nconst title = titleMatch?.[1]?.trim() ?? rawTitle.replace(' | LinkedIn', '').trim();\nconst location = titleMatch?.[2]?.trim() ?? null;\nconst company = \n  html.match(/\"companyName\":\"(.*?)\"/)?.[1] ??\n  html.match(/\"name\":\"(.*?)\",\"url\":\"https:\\/\\/www\\.linkedin\\.com\\/company/)?.[1] ??\n  html.match(/,\"topCard\".*?\"name\":\"(.*?)\"/)?.[1] ??\n  rawTitle.match(/^(.*?)\\s+hiring/)?.[1]?.trim() ?? // fallback: grab from title tag\n  null;\nconst salary = html.match(/\"formattedSalaryRange\":\"(.*?)\"/)?.[1] ?? null;\n\nreturn [{ json: { title, company, location, salary }}];"
      },
