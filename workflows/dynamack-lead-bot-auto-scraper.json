    {
      "parameters": {
        "jsCode": "// Extract organic results, pull URL + title + snippet\nconst results = $input.first().json.organic_results || [];\nconst niche = $('Filter — Active Niches Only').first().json['Niche / Industry'] || '';\nconst skill = $('Filter — Active Niches Only').first().json['Jasmine\\'s Skill Used'] || '';\n\n// Skip big brands / directories / social platforms\nconst skipDomains = ['linkedin.com','facebook.com','instagram.com','twitter.com','x.com','yelp.com','yellowpages.com','bbb.org','amazon.com','indeed.com','glassdoor.com','wikipedia.org'];\n\nconst cleaned = results\n  .filter(r => {\n    if (!r.link) return false;\n    return !skipDomains.some(d => r.link.includes(d));\n  })\n  .map(r => ({\n    url: r.link,\n    company_hint: r.title ? r.title.split('|')[0].split('-')[0].trim() : '',\n    notes: r.snippet ? r.snippet.slice(0, 120) : '',\n    source: 'Bot',\n    niche: niche,\n    skill_used: skill,\n    date_added: new Date().toISOString().slice(0,10)\n  }));\n\nreturn cleaned.map(item => ({ json: item }));"
      },
