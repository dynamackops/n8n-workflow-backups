    {
      "parameters": {
        "jsCode": "// Check each URL against the dedup log — skip if already seen\n// FIX: the dedup log's automated write columns are source/niche/skill_used/date_added/url/company_hint/notes\n// (autoMapInputData matches by field name). The manual 'URL Seen' column is never populated by the bot,\n// so this must read the 'url' field instead — reading 'URL Seen' meant every incoming lead looked new.\nconst dedupRows = $('Sheets — Read Dedup Log').all().map(item => item.json['url'] || '');\nconst incoming = $('Extract + Clean Results').all();\n\nconst newLeads = incoming.filter(item => {\n  const url = item.json.url || '';\n  const domain = (() => { try { return new URL(url).hostname; } catch(e) { return url; } })();\n  return !dedupRows.some(seen => seen.includes(domain));\n});\n\nif (newLeads.length === 0) {\n  // Return a no-op signal so downstream nodes don't error\n  return [{ json: { skip: true, message: 'No new leads found — all already in dedup log' } }];\n}\n\nreturn newLeads;"
      },
