      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst screenshots = data.screenshots || [];\n\n// Build email body\nlet screenshotSection = screenshots.length > 0 \n  ? `\\n\\n📸 ${screenshots.length} screenshot(s) attached` \n  : '';\n\nreturn [{\n  json: {\n    ...data,\n    emailBody: `\nNEW SIGNL CYCLE FEEDBACK\n━━━━━━━━━━━━━━━━━━━━━━━\nFrom: ${data.name} (${data.email})\nUsing for: ${data.tenure}\nStars: ${data.star_rating}/5\nNPS: ${data.nps_score}/10\n\nWHAT THEY LOVE\n${data.what_they_love || 'Not provided'}\n\nBUG REPORTED: ${data.bug_reported}\n${data.bug_description ? 'Bug: ' + data.bug_description : ''}${screenshotSection}\n\nFEATURE REQUESTS\n${data.feature_requests || 'None selected'}\n\nCUSTOM IDEA\n${data.custom_idea || 'None'}\n\nOTHER NOTES\n${data.other || 'None'}\n\nSubmitted: ${data.submitted_at}\n    `.trim(),\n    hasScreenshots: screenshots.length > 0,\n    screenshotCount: screenshots.length\n  }\n}];"
      },
